# JellySqueeze — copy this file to .env and fill in your own values
# (config.yml and .env are gitignored; your secrets never get committed)

# ── Jellyfin (required) ──────────────────────────────────────────────
# Your Jellyfin server + an API key from Dashboard → API Keys.
JELLYFIN_BASE_URL=http://your-jellyfin:8096
JELLYFIN_API_KEY=your-jellyfin-api-key

# ── MCP API key (your choice — anyone with this token can call /mcp) ──
# Leave empty to keep the MCP endpoint open.
JELLYSQUEEZE_MCP_API_KEY=your-own-mcp-token

# ── Control-panel password ───────────────────────────────────────────
# Password you use to log into http://localhost:9238/
WEBUI_PASSWORD=your-panel-password

# ── Optional tuning ──────────────────────────────────────────────────
TARGET_BR=3000
MAX_BR=3300
BUFSIZE=6600
DEFAULT_CRF=23
DEFAULT_WORKERS=1
CLEANUP_TMP=0
BACKUP_ORIGINALS=0
DRY_RUN=0