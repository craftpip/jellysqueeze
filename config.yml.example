libraries:
  - name: Movies HD
    paths:
      - /path/to/media/movies-hd
    profile: profile_movies_hd
  - name: TV Shows
    paths:
      - /path/to/media/shows
    profile: profile_shows
  - name: Movies
    paths:
      - /path/to/media/movies
    profile: profile_movies
  - name: Shows HD
    paths:
      - /path/to/media/shows-hd
    profile: profile_shows_hd

profiles:
  profile_movies_hd:
    target_bitrate: 3000
    max_bitrate: 4500
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    keep_subtitles: true
    minimum_savings_percent: 10

  profile_shows:
    target_bitrate: 2000
    max_bitrate: 3000
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    keep_subtitles: true
    minimum_savings_percent: 10

  profile_movies:
    target_bitrate: 3000
    max_bitrate: 4500
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    keep_subtitles: true
    minimum_savings_percent: 10

  profile_shows_hd:
    target_bitrate: 2000
    max_bitrate: 3000
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    keep_subtitles: true
    minimum_savings_percent: 10

webui:
  enabled: true
  host: "0.0.0.0"
  port: 8080

mcp:
  enabled: true
  host: "0.0.0.0"
  port: 9090
