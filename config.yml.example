libraries:
  - name: Movies HD
    paths:
      - /path/to/media/movies-hd
    target_bitrate: 3000
    max_bitrate: 4500
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    minimum_savings_percent: 10

  - name: TV Shows
    paths:
      - /path/to/media/shows
    target_bitrate: 2000
    max_bitrate: 3000
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    minimum_savings_percent: 10

  - name: Movies
    paths:
      - /path/to/media/movies
    target_bitrate: 3000
    max_bitrate: 4500
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    minimum_savings_percent: 10

  - name: Shows HD
    paths:
      - /path/to/media/shows-hd
    target_bitrate: 2000
    max_bitrate: 3000
    encoder: nvidia
    keep_audio_langs:
      - eng
      - en
      - jpn
      - ja
      - hi
      - hin
    minimum_savings_percent: 10

webui:
  enabled: true
  host: "0.0.0.0"
  port: 8080

mcp:
  enabled: true
  host: "0.0.0.0"
  port: 9090
