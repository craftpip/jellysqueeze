# ignore all files in this directory except .gitkeep
# placed at repository root
**/test_files/*
!**/test_files/.gitkeep
__pycache__/
.pytest_cache/
venv/
.venv/

!README.md

# Environment / secrets / config files
.env
config.yml

# Runtime wrapper
scripts/convert.sh

# All runtime data
var/*
!var/.gitkeep
nohup.out
o.txt

# Scan output files
escan*
fscan*

# Platform-specific scripts
work.bat
pastlivestreams.log
